{
  "name": "@cpn-engage/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*.test.ts",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --minify --outfile=dist/server.mjs --external:fastify --external:@fastify/cors --external:jose --external:postgres"
  },
  "dependencies": {
    "@cpn-engage/shared": "workspace:*",
    "@fastify/cors": "^11.1.0",
    "fastify": "^5.3.2",
    "jose": "^5.9.6",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^24.0.8",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "esbuild": "^0.27.7"
  }
}
