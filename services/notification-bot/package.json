{
  "name": "@cpn-engage/notification-bot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --minify --outfile=dist/server.mjs --jsx=automatic --external:chat --external:@chat-adapter/state-memory --external:@chat-adapter/teams --external:express --external:pg-boss --external:postgres"
  },
  "dependencies": {
    "@cpn-engage/shared": "workspace:*",
    "@chat-adapter/state-memory": "^4.31.0",
    "@chat-adapter/teams": "^4.31.0",
    "chat": "^4.31.0",
    "express": "^5.2.1",
    "pg-boss": "^12.23.0",
    "postgres": "^3.4.9",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.8",
    "typescript": "^5.8.3",
    "esbuild": "^0.27.7"
  }
}
