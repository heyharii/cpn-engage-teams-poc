# CPN Engage — local/on-prem docker-compose config. Copy to `.env` and fill
# in the Teams values when you actually need Teams to reach this stack.
# Every value has a working default for a local infra smoke test (no Teams).

POSTGRES_USER=cpn_engage
POSTGRES_PASSWORD=cpn_engage_local
POSTGRES_DB=cpn_engage

# Bot Framework credentials (Azure Bot + Entra app registration). Leave blank
# to run the stack locally without real Teams traffic.
TEAMS_APP_TYPE=MultiTenant
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
TEAMS_APP_TENANT_ID=

# Teams SSO token validation for the Profile tab (Application ID URI).
APPLICATION_ID_URI=

# v2 flows to OFFER alongside v1 (comma-separated, or "all"). This adds a hub
# button; it never removes the v1 one, so both can be tried in the same chat.
# Currently only `recognise` has a v2: one card with a Teams People Picker
# instead of the four-step typed wizard. Needs TEAMS_APP_ID/PASSWORD, since
# that card goes out through the Bot Connector.
BOT_FLOWS_V2=

# Optional shared secret to protect the bot's proactive push endpoints.
PUSH_TOKEN=

# CORS origin allowed to call the bot's /internal/* ops endpoints from a
# browser (the Admin Console). "*" is fine for local/dev.
ADMIN_ORIGIN=*
